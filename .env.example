# Supabase (EU region). Service-role key is server-only – never expose to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (verify your sending domain: SPF/DKIM/DMARC)
RESEND_API_KEY=
MAIL_FROM="Bloom <hallo@bloom.fit>"

NEXT_PUBLIC_SITE_URL=https://bloom.fit

# Optional: Plausible (EU, cookie-free) domain, e.g. bloom.fit
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Public Supabase keys (safe for the browser; RLS protects data)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Comma-separated emails allowed to use /admin (invites)
ADMIN_EMAILS=
